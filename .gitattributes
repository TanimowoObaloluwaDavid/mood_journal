# Normalise line endings on checkin so a Windows clone and a Linux CI run
# produce identical diffs.
* text=auto eol=lf

# Files that must stay CRLF for tooling to work.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files: never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.jar    binary
*.keystore binary
*.jks    binary
*.apk    binary
*.aab    binary
*.so     binary
*.dylib  binary
*.framework binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary

# Generated by Flutter's build, committed so a clone works without codegen.
lib/data/local/app_database.g.dart linguist-generated=true

# Lockfile is committed on purpose; flag it so GitHub does not collapse it in diffs.
/pubspec.lock linguist-generated=true -diff
